{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "python",

    "ServiceBusConnection": "<SB namespace connection string with Listen rights (consumer)>",
    "ServiceBusSendConnection": "<SB namespace connection string with Send rights (producer)>",
    "ServiceBusQueue": "plm-sync",

    "PG_CONN": "<host=... port=5432 dbname=plm user=plm password=...> (or PG_HOST/PG_PORT/...)",

    "PLM_SOURCE_PG_CONN": "<host=<src-host> port=5432 dbname=<src-db> user=<src-user> password=<pw> sslmode=require> (or PLM_SOURCE_PG_HOST/PORT/DB/USER/PASSWORD)",

    "WRIKE_TOKEN_PRAVEEN": "<Wrike permanent access token - BAKING/HOT DRINKS author>",
    "WRIKE_TOKEN_JESSE": "<Wrike permanent access token - CONFECTION author>",
    "WRIKE_HOST": "www.wrike.com",
    "WRIKE_RETAIL_ITEM_TYPE_ID": "<Custom Item Type id for 'Retail Item' (GET /custom_item_types)>",
    "WRIKE_SPACE_ID": "<Wrike space id - folder sync rebuilds wrike_folder_map from its top-level folders each run; the catch-all author (WRIKE_TOKEN_PRAVEEN) must be a member of this space with folder-create permission>",

    "APPLICATIONINSIGHTS_CONNECTION_STRING": "<from App Insights resource>"
  }
}
